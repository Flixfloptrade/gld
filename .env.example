PORT=3001
DATA_DIR=./data
# Optional: set a securely managed 32-byte hex key in production. If omitted, the app creates a local key file under DATA_DIR.
# DATA_ENCRYPTION_KEY=
ADMIN_EMAIL=lasisfantasen@hotmail.com
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
ADMIN_PORT=3003
ADMIN_BACKEND_URL=http://127.0.0.1:3001

SELL_WORKFLOW_ENABLED=false
CHECKOUT_ESTIMATED_TAX_RATE=0.08
CHECKOUT_DELIVERY_FEE_CENTS=2500
CHECKOUT_VAULT_FEE_CENTS=1000
IDENTITY_PROVIDER_ENABLED=false
# Optional stable encryption key for uploaded identity documents (64 hex characters).
# Keep in a secret manager and back up separately.
# VERIFICATION_DOCUMENTS_KEY=
# On-chain crypto checkout. Disabled until approved verification services and identity checks are configured.
# Public receiving addresses only. Never put a private key or seed phrase here.
CRYPTO_PAYMENTS_ENABLED=false
CRYPTO_BTC_RECEIVE_ADDRESS=
# Provided public address used for Ethereum ERC-20 and BNB Smart Chain BEP-20 transfers.
CRYPTO_EVM_RECEIVE_ADDRESS=
# Provided public address used for TRON TRC-20 transfers.
CRYPTO_TRON_RECEIVE_ADDRESS=
# Required by the server-side transaction verifiers. Store real API keys in .env or a secret manager.
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
# Optional Blockchain.com Explorer key. Store in a secret manager.
# BLOCKCHAIN_EXPLORER_API_KEY=

# Required: Neon PostgreSQL connection string. Use the pooled connection URL for the web app.
# Copy it from Neon Console → your project → Connect. Keep credentials private.
DATABASE_URL=
# Optional: direct (unpooled) URL for migrations/admin tasks only.
DATABASE_URL_UNPOOLED=

# Optional NGN-to-USD reference rate override; leave blank to use the live reference-rate service.
USD_NGN_RATE=
# Configure verified payment instructions before accepting customer deposits.
FUNDING_BANK_NAME=
FUNDING_BANK_ACCOUNT_NAME=
FUNDING_BANK_ACCOUNT_NUMBER=
FUNDING_PAYMENT_NOTE=

# SecureSMTP transactional email settings. Keep the real API key in Render's secret environment settings only.
SECURESMTP_API_KEY=
# Shared relay sender display name. Replies go to this address; it is not the sender domain.
EMAIL_FROM_NAME=Gold Investment
EMAIL_REPLY_TO=lasisfantasen@hotmail.com
APP_BASE_URL=https://gold-investment.onrender.com
# Inbox you control, used only by `node scripts/test-securesmtp.js`
TEST_EMAIL=
